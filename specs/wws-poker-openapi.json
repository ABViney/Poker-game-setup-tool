{"openapi":"3.1.0","info":{"title":"bot requester","description":"\nSeat scripted poker bots into a game on the BAHMS poker server and let this\nservice play them.\n\n**Typical flow**\n\n1. Get a `game_id` for a game that already exists on the poker server\n2. `POST /join` once per bot - each with a unique token and agent type, or\n   `POST /join/bulk` to seat them all in one request\n3. Either start the game yourself with your player, or `POST /start` as one of\n   the bots with their token, once the table is set.\n4. This service connects to the game and plays every seat it owns. A game whose state\n   has not changed for 600s is dropped\n\n**Agent types**: `adaptive, allin, bayesian, bluffer, callstation, float, gearshift, limper, minraiser, posaware, potodds, random, shortstack, tag, threebet, trapper`\n","version":"1.0"},"paths":{"/health":{"get":{"tags":["info"],"summary":"Liveness check","operationId":"health_health_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HealthResponse"}}}}}}},"/agents":{"get":{"tags":["info"],"summary":"List the agent types on offer","operationId":"agents_agents_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/AgentsResponse"}}}}}}},"/status":{"get":{"tags":["info"],"summary":"Aggregate counts for this instance","description":"Totals only - games by state, bots, and feed health. `game_ids` lists everything tracked; pass any of them to `/status/games?ids=...` for the per-game and per-bot detail.","operationId":"status_status_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/StatusResponse"}}}}}}},"/status/games":{"get":{"tags":["info"],"summary":"Status for specific games","description":"Give status on games, repeat the parameter (`?ids=12&ids=13`) or use a comma-separated list (`?ids=12,13`) - both work, and may be mixed. Ids this instance is not tracking come back under `not_found` rather than as an error.","operationId":"status_games_status_games_get","parameters":[{"name":"ids","in":"query","required":false,"schema":{"type":"array","items":{"type":"string"},"description":"game ids; repeatable and/or comma-separated","examples":[["12","13"]],"title":"Ids"},"description":"game ids; repeatable and/or comma-separated"}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GamesStatusResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/join":{"post":{"tags":["bots"],"summary":"Seat a bot in an existing game","description":"Joins `game_id` using `token` and plays that seat as `agent`. Call once per bot.\n\n400 when: the game does not exist, the token is rejected, the agent type is unknown, etc","operationId":"join_join_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/JoinRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/JoinResponse"}}}},"400":{"description":"Rejected - reason in `error`","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/join/bulk":{"post":{"tags":["bots"],"summary":"Seat several bots in one call","description":"Takes the same objects as `/join`, as a list, and seats them one at a time. Always 200 unless the request itself is malformed: each entry reports its own `ok`, so one bad token does not hide the seats that worked. Check `failed`.","operationId":"join_bulk_join_bulk_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/BulkJoinRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/BulkJoinResponse"}}}},"400":{"description":"Rejected - reason in `error`","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/start":{"post":{"tags":["bots"],"summary":"Start a game this instance has bots in","description":"Sends the start request as one of this instance's bots. The poker server decides whether the table can start.\n\n400 when: this instance has no bots in that game, the token does not match any of them, the game was dropped (timed out), or the poker server refuses - its message is passed through.","operationId":"start_start_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/StartRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/StartResponse"}}}},"400":{"description":"Rejected - reason in `error`","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/stop":{"post":{"tags":["bots"],"summary":"Disconnect every bot in a game","description":"Closes each bot's event-hub socket, stops polling, and drops the game from tracking entirely, so a later `/join` starts clean.\n\n400 when this instance has no bots in that game, or `token` was supplied and matches none of them.","operationId":"stop_stop_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/StopRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/StopResponse"}}}},"400":{"description":"Rejected - reason in `error`","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}}},"components":{"schemas":{"AgentType":{"type":"string","enum":["adaptive","allin","bayesian","bluffer","callstation","float","gearshift","limper","minraiser","posaware","potodds","random","shortstack","tag","threebet","trapper"],"title":"AgentType"},"AgentsResponse":{"properties":{"agents":{"items":{"type":"string"},"type":"array","title":"Agents"},"note":{"type":"string","title":"Note"}},"type":"object","required":["agents","note"],"title":"AgentsResponse"},"BotCounts":{"properties":{"total":{"type":"integer","title":"Total"},"active":{"type":"integer","title":"Active","description":"bots in games that are not dropped"},"actions":{"type":"integer","title":"Actions","description":"actions sent since start"}},"type":"object","required":["total","active","actions"],"title":"BotCounts"},"BotStatus":{"properties":{"user_id":{"type":"string","title":"User Id"},"agent":{"type":"string","title":"Agent"},"actions":{"type":"integer","title":"Actions"},"last_action":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Last Action"},"feed":{"anyOf":[{"$ref":"#/components/schemas/FeedStatus"},{"type":"null"}]}},"type":"object","required":["user_id","agent","actions"],"title":"BotStatus"},"BulkJoinRequest":{"properties":{"joins":{"items":{"$ref":"#/components/schemas/JoinRequest"},"type":"array","minItems":1,"title":"Joins","description":"one entry per seat, in the order to seat them"}},"type":"object","required":["joins"],"title":"BulkJoinRequest","examples":[{"joins":[{"agent":"tag","game_id":"12","token":"bahms.aBcDeFgH1.one","user_id":"67"},{"agent":"random","game_id":"12","token":"bahms.aBcDeFgH2.two","user_id":"68"}]}]},"BulkJoinResponse":{"properties":{"requested":{"type":"integer","title":"Requested"},"joined":{"type":"integer","title":"Joined","description":"how many seats were taken"},"failed":{"type":"integer","title":"Failed"},"results":{"items":{"$ref":"#/components/schemas/BulkJoinResult"},"type":"array","title":"Results"}},"type":"object","required":["requested","joined","failed","results"],"title":"BulkJoinResponse"},"BulkJoinResult":{"properties":{"index":{"type":"integer","title":"Index","description":"position in the request list"},"ok":{"type":"boolean","title":"Ok"},"game_id":{"type":"string","title":"Game Id","default":""},"user_id":{"type":"string","title":"User Id","default":""},"error":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Error","description":"set when ok is false"},"agent":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Agent"},"seat":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Seat"},"bots_in_game":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Bots In Game"},"joined":{"anyOf":[{"type":"boolean"},{"type":"null"}],"title":"Joined"}},"type":"object","required":["index","ok"],"title":"BulkJoinResult"},"ErrorResponse":{"properties":{"joined":{"type":"boolean","title":"Joined","default":false},"error":{"type":"string","title":"Error"}},"type":"object","required":["error"],"title":"ErrorResponse","examples":[{"error":"game 12 is already in progress","joined":false}]},"FeedCounts":{"properties":{"total":{"type":"integer","title":"Total"},"connected":{"type":"integer","title":"Connected"},"game_over":{"type":"integer","title":"Game Over","description":"feeds closed because the game ended"},"pushes":{"type":"integer","title":"Pushes","description":"state events received"},"masked_pushes":{"type":"integer","title":"Masked Pushes","description":"pushes discarded for hiding our hand"},"ws_reads":{"type":"integer","title":"Ws Reads","description":"state reads served by a push"},"http_reads":{"type":"integer","title":"Http Reads","description":"state reads that needed a GET"}},"type":"object","required":["total","connected","game_over","pushes","masked_pushes","ws_reads","http_reads"],"title":"FeedCounts"},"FeedStatus":{"properties":{"url":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Url"},"connected":{"type":"boolean","title":"Connected","default":false},"pushes":{"type":"integer","title":"Pushes","default":0},"reconnects":{"type":"integer","title":"Reconnects","default":0},"last_error":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Last Error"},"ws_reads":{"type":"integer","title":"Ws Reads","description":"state reads served by a push","default":0},"http_reads":{"type":"integer","title":"Http Reads","description":"state reads that needed a GET","default":0},"masked_pushes":{"type":"integer","title":"Masked Pushes","default":0},"events":{"type":"integer","title":"Events","description":"events of any type received","default":0},"silent_seconds":{"type":"number","title":"Silent Seconds","description":"since the last event of any kind; a game is released once this passes EVENT_TIMEOUT","default":0.0},"game_over":{"type":"boolean","title":"Game Over","description":"the SDK closes the socket on game_over","default":false},"close_reason":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Close Reason"}},"type":"object","title":"FeedStatus"},"GameCounts":{"properties":{"total":{"type":"integer","title":"Total"},"active":{"type":"integer","title":"Active","description":"not dropped"},"started":{"type":"integer","title":"Started","description":"active and in progress"},"waiting":{"type":"integer","title":"Waiting","description":"active but not started yet"},"idle":{"type":"integer","title":"Idle","description":"active with no state change for longer than idle_threshold_seconds"},"dropped":{"type":"integer","title":"Dropped","description":"released; awaiting cleanup"}},"type":"object","required":["total","active","started","waiting","idle","dropped"],"title":"GameCounts"},"GameStatus":{"properties":{"game_id":{"type":"string","title":"Game Id"},"started":{"type":"boolean","title":"Started"},"dropped":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Dropped","description":"why polling stopped, if it has"},"idle_seconds":{"type":"number","title":"Idle Seconds"},"hands_started":{"type":"integer","title":"Hands Started","description":"hands this instance dealt itself because the server announced setup and never dealt one","default":0},"bots":{"items":{"$ref":"#/components/schemas/BotStatus"},"type":"array","title":"Bots"}},"type":"object","required":["game_id","started","idle_seconds","bots"],"title":"GameStatus"},"GamesStatusResponse":{"properties":{"base_url":{"type":"string","title":"Base Url"},"poll_interval":{"type":"number","title":"Poll Interval"},"idle_timeout":{"type":"number","title":"Idle Timeout"},"websocket":{"type":"boolean","title":"Websocket","description":"whether seats subscribe to the push feed","default":false},"games":{"items":{"$ref":"#/components/schemas/GameStatus"},"type":"array","title":"Games"},"requested":{"items":{"type":"string"},"type":"array","title":"Requested","description":"ids asked for, de-duplicated"},"not_found":{"items":{"type":"string"},"type":"array","title":"Not Found","description":"ids this instance is not tracking - either never joined or already released"}},"type":"object","required":["base_url","poll_interval","idle_timeout","games"],"title":"GamesStatusResponse"},"HTTPValidationError":{"properties":{"detail":{"items":{"$ref":"#/components/schemas/ValidationError"},"type":"array","title":"Detail"}},"type":"object","title":"HTTPValidationError"},"HealthResponse":{"properties":{"ok":{"type":"boolean","title":"Ok"},"base_url":{"type":"string","title":"Base Url"}},"type":"object","required":["ok","base_url"],"title":"HealthResponse"},"JoinRequest":{"properties":{"game_id":{"type":"string","title":"Game Id","description":"id of an existing game on the poker server","examples":["12"]},"token":{"type":"string","title":"Token","description":"the bot user's API token","examples":["bahms.aBcDeFgH12345678.SoBespoke"]},"agent":{"$ref":"#/components/schemas/AgentType","description":"which strategy this bot plays","examples":["tag"]},"user_id":{"type":"string","title":"User Id","description":"the user ID of the bot","examples":["67"]}},"type":"object","required":["game_id","token","agent","user_id"],"title":"JoinRequest","examples":[{"agent":"tag","game_id":"12","token":"bahms.aBcDeFgH12345678.SoBespoke","user_id":"67"}]},"JoinResponse":{"properties":{"joined":{"type":"boolean","title":"Joined","default":true},"game_id":{"type":"string","title":"Game Id"},"user_id":{"type":"string","title":"User Id"},"agent":{"type":"string","title":"Agent"},"seat":{"type":"integer","title":"Seat","description":"seat index at the table, -1 if not found"},"bots_in_game":{"type":"integer","title":"Bots In Game","description":"how many bots this instance now has"}},"type":"object","required":["game_id","user_id","agent","seat","bots_in_game"],"title":"JoinResponse"},"StartRequest":{"properties":{"game_id":{"type":"string","title":"Game Id","examples":["12"]},"token":{"type":"string","title":"Token","description":"must belong to a bot this instance has in that game","examples":["bahms.aBcDeFgH12345678.SoBespoke"]}},"type":"object","required":["game_id","token"],"title":"StartRequest","examples":[{"game_id":"12","token":"bahms.aBcDeFgH12345678.SoBespoke"}]},"StartResponse":{"properties":{"started":{"type":"boolean","title":"Started","default":true},"game_id":{"type":"string","title":"Game Id"},"requested_by":{"type":"string","title":"Requested By","description":"user_id of the bot used to send the request"}},"type":"object","required":["game_id","requested_by"],"title":"StartResponse"},"StatusResponse":{"properties":{"base_url":{"type":"string","title":"Base Url"},"poll_interval":{"type":"number","title":"Poll Interval"},"idle_timeout":{"type":"number","title":"Idle Timeout"},"websocket":{"type":"boolean","title":"Websocket","description":"whether seats subscribe to the push feed","default":false},"games":{"$ref":"#/components/schemas/GameCounts"},"bots":{"$ref":"#/components/schemas/BotCounts"},"feeds":{"$ref":"#/components/schemas/FeedCounts"},"idle_threshold_seconds":{"anyOf":[{"type":"number"},{"type":"null"}],"title":"Idle Threshold Seconds","description":"half of idle_timeout; null when disabled"},"oldest_idle_seconds":{"type":"number","title":"Oldest Idle Seconds","description":"longest any active game has gone without a state change","default":0.0},"game_ids":{"items":{"type":"string"},"type":"array","title":"Game Ids","description":"every tracked id, so you know what to pass to /status/games"}},"type":"object","required":["base_url","poll_interval","idle_timeout","games","bots","feeds"],"title":"StatusResponse"},"StopRequest":{"properties":{"game_id":{"type":"string","title":"Game Id","description":"game whose bots should disconnect","examples":["12"]},"token":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Token","description":"optional; if given it must belong to a bot this instance has in that game, otherwise the request is refused","examples":["bahms.aBcDeFgH12345678.SoBespoke"]}},"type":"object","required":["game_id"],"title":"StopRequest","examples":[{"game_id":"12"}]},"StopResponse":{"properties":{"stopped":{"type":"boolean","title":"Stopped","default":true},"game_id":{"type":"string","title":"Game Id"},"bots_released":{"type":"integer","title":"Bots Released","description":"how many bots were disconnected"},"user_ids":{"items":{"type":"string"},"type":"array","title":"User Ids"}},"type":"object","required":["game_id","bots_released"],"title":"StopResponse"},"ValidationError":{"properties":{"loc":{"items":{"anyOf":[{"type":"string"},{"type":"integer"}]},"type":"array","title":"Location"},"msg":{"type":"string","title":"Message"},"type":{"type":"string","title":"Error Type"}},"type":"object","required":["loc","msg","type"],"title":"ValidationError"}}},"tags":[{"name":"bots","description":"Seat bots and start games"},{"name":"info","description":"What this instance is doing now"}]}